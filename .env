# =============================================================================
# ZenML Archive ETL — Environment Configuration
# =============================================================================
# این فایل را کپی نکنید؛ همین فایل را ویرایش کنید.
# مقادیر پیش‌فرض برای توسعه محلی با docker-compose تنظیم شده‌اند.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (docker-compose + application)
# -----------------------------------------------------------------------------
POSTGRES_USER=archive_user
POSTGRES_PASSWORD=archive_password
POSTGRES_DB=archive
POSTGRES_HOST_PORT=15432

# DSN کامل برای اتصال از پایتون (host port محلی)
POSTGRES_DSN=postgresql://archive_user:archive_password@127.0.0.1:15432/archive

# -----------------------------------------------------------------------------
# Storage paths
# -----------------------------------------------------------------------------
# مسیر Bronze (Parquet). می‌تواند مسیر محلی یا s3:// باشد.
PARQUET_ROOT=data/bronze/archive_articles

# مسیر ذخیره تصاویر دانلودشده
MEDIA_ROOT=data/media

# -----------------------------------------------------------------------------
# Scraping / batch behaviour
# -----------------------------------------------------------------------------
# حداکثر تعداد مقاله در هر archive page (معمولاً ۲۰)
MAX_ARTICLES_PER_PAGE=20

# پس از این مدت (ثانیه) claimهای stale قابل reclaim هستند
CLAIM_STALE_AFTER_SECONDS=3600

# timeout درخواست‌های HTTP / Selenium (ثانیه)
REQUEST_TIMEOUT_SECONDS=20

# دانلود تصاویر مقالات (true / false)
DOWNLOAD_IMAGES=true

# -----------------------------------------------------------------------------
# ZenML logging
# -----------------------------------------------------------------------------
ZENML_LOGGING_VERBOSITY=INFO
